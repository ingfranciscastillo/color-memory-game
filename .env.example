# Neon Postgres, pooled connection (host with "-pooler").
DATABASE_URL=

# Better Auth. Generate the secret with `openssl rand -base64 32`.
# BETTER_AUTH_URL is the public URL of the app, without a trailing slash.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public site URL, without a trailing slash: canonical, Open Graph, sitemap.
VITE_SITE_URL=http://localhost:3000

# Discord sign-in. The button only shows when both are set.
# Redirect URL: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Account emails (codes, verification, password reset) via Resend.
# Without the key, emails are printed to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Color Memory <onboarding@resend.dev>"

# Cloudflare Turnstile on everything that sends an email or checks a
# password. Without both keys no captcha is required. For development, the
# test keys 1x00000000000000000000AA and 1x0000000000000000000000000000000AA
# always pass.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Daily cleanup (Vercel cron): Vercel sends it as a Bearer token to
# /api/cron/cleanup. Generate one with `openssl rand -base64 32`.
CRON_SECRET=
